PORT=4000

# Get a key from https://console.anthropic.com/ to enable AI classification.
# Without this, grievances still work but fall back to "General Administration" / "MEDIUM".
ANTHROPIC_API_KEY=your_key_here

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGIN=http://localhost:5173

# --- Choose ONE storage option for production ---
#
# Option A (free): Turso — leave DATA_DIR blank and set these two instead.
# Get them from https://turso.tech (free tier, see DEPLOY.md for setup steps).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Option B (paid, no migration needed): a Render persistent disk mount path
# (e.g. /var/data). Leave TURSO_* blank if using this instead.
DATA_DIR=
