# Nginx config for the Grievance Tracker Portal
# Copy this to /etc/nginx/sites-available/grievance-tracker and symlink it into sites-enabled.
# Replace YOUR_DOMAIN_OR_IP below with your actual domain (or the server's public IP if you don't have one yet).

server {
    listen 80;
    server_name YOUR_DOMAIN_OR_IP;

    # Serve the built frontend
    root /home/ubuntu/grievance-tracker-app/frontend/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy API requests to the Node backend running on port 4000
    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    client_max_body_size 10M;
}
